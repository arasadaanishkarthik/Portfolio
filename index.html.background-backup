        }

        /* =========================================
           4. TECHNOLOGY PROFILE & 3D HERO TILT
           ========================================= */
        const technologyProfile = document.getElementById('technology-profile');
        const profileLabel = document.getElementById('profile-label');
        const profileChoices = document.querySelectorAll('[data-profile-choice]');
        const technologyProfiles = {
            react: { label: 'REACT MODE', accent: '#00f0ff', accentAlt: '#3b82f6' },
            node: { label: 'NODE MODE', accent: '#10b981', accentAlt: '#059669' },
            javascript: { label: 'JAVASCRIPT MODE', accent: '#facc15', accentAlt: '#f59e0b' },
            fullstack: { label: 'FULL STACK MODE', accent: '#c084fc', accentAlt: '#8b5cf6' }
        };

        function setTechnologyProfile(profileName) {
            const profile = technologyProfiles[profileName] || technologyProfiles.react;
            if (!technologyProfile || !profileLabel) return;
            const nextProfileName = technologyProfiles[profileName] ? profileName : 'react';
            technologyProfile.classList.remove('is-morphing');
            void technologyProfile.offsetWidth;
            technologyProfile.classList.add('is-morphing');
            technologyProfile.dataset.profile = nextProfileName;
            technologyProfile.style.setProperty('--profile-accent', profile.accent);
            technologyProfile.style.setProperty('--profile-accent-alt', profile.accentAlt);
            profileLabel.innerHTML = '<span class="status-dot"></span> ' + profile.label;
            profileChoices.forEach(choice => {
                choice.setAttribute('aria-pressed', choice.dataset.profileChoice === nextProfileName ? 'true' : 'false');
            });
            window.setTimeout(() => technologyProfile.classList.remove('is-morphing'), 700);
        }

        profileChoices.forEach(choice => {
            choice.addEventListener('click', () => setTechnologyProfile(choice.dataset.profileChoice));
        });
        setTechnologyProfile('react');

        // Hero 3D Pointer Parallax Tilt
        const heroSection = document.getElementById('home');
        if (heroSection && technologyProfile && !isTouchDevice && !prefersReducedMotion.matches) {
            let targetTiltX = 0;
            let targetTiltY = 0;
            let currentTiltX = 0;
            let currentTiltY = 0;

            heroSection.addEventListener('mousemove', (e) => {
                if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
                const rect = heroSection.getBoundingClientRect();
                const x = (e.clientX - rect.left) / rect.width - 0.5;
                const y = (e.clientY - rect.top) / rect.height - 0.5;
                targetTiltX = -y * 18;
                targetTiltY = x * 22;
            });

            heroSection.addEventListener('mouseleave', () => {
                targetTiltX = 0;
                targetTiltY = 0;
            });

            let heroTiltFrame = 0;
            function updateHeroTilt() {
                if (!pageIsVisible) {
                    heroTiltFrame = 0;
                    return;
                }
                currentTiltX += (targetTiltX - currentTiltX) * 0.08;
                currentTiltY += (targetTiltY - currentTiltY) * 0.08;
                technologyProfile.style.transform = 'rotateX(' + currentTiltX + 'deg) rotateY(' + currentTiltY + 'deg)';
                heroTiltFrame = requestAnimationFrame(updateHeroTilt);
                window.addEventListener('portfolio:visibility-resume', () => {
                    if (!heroTiltFrame) heroTiltFrame = requestAnimationFrame(updateHeroTilt);
                });
            }
            heroTiltFrame = requestAnimationFrame(updateHeroTilt);
        }

        /* =========================================
           5. AMBIENT CURSOR SPOTLIGHT & PARALLAX GRID
           ========================================= */
        const cursorSpotlight = document.getElementById('cursor-spotlight');
        const spatialGridPlane = document.getElementById('spatial-grid-plane');
        let mouseX = window.innerWidth / 2;
        let mouseY = window.innerHeight / 2;
        let spotX = mouseX;
        let spotY = mouseY;

        let cursorFrame = 0;
        if (!isTouchDevice && !prefersReducedMotion.matches) {
            window.addEventListener('mousemove', (e) => {
                mouseX = e.clientX;
                mouseY = e.clientY;
            }, { passive: true });
        }

        function updateCursorSpotlight() {
            if (!pageIsVisible) {
                cursorFrame = 0;
                return;
            }
            spotX += (mouseX - spotX) * 0.12;
            spotY += (mouseY - spotY) * 0.12;
            if (cursorSpotlight) {
                cursorSpotlight.style.left = spotX + 'px';
                cursorSpotlight.style.top = spotY + 'px';
            }
            if (spatialGridPlane && !prefersReducedMotion.matches && !isTouchDevice) {
                const shiftX = (mouseX / window.innerWidth - 0.5) * 20;
                const shiftY = (mouseY / window.innerHeight - 0.5) * 15;
                spatialGridPlane.style.transform = 'rotateX(68deg) translateY(-25%) translate(' + shiftX + 'px, ' + shiftY + 'px)';
            }
