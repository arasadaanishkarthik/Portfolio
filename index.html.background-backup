<!DOCTYPE html>
<html lang="en" data-theme="midnight">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Arasada Anish Karthik | Digital Journey</title>
    
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    
    <!-- Google Fonts: Editorial Syne, Plus Jakarta Sans, Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Syne:wght@700;800&display=swap"
        rel="stylesheet">
    
    <!-- Lenis Smooth Scroll -->
    <script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>

    <style>
        /* ==========================================================================
           1. CSS VARIABLES, THEMES & TOKENS
           ========================================================================== */
        
        /* 1. MIDNIGHT (Default Cinematic Cyberpunk) */
        :root[data-theme="midnight"] {
            --bg-primary: #040711;
            --bg-secondary: #0b1122;
            --bg-tertiary: #111a33;
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --accent-primary: #3b82f6;
            --accent-secondary: #8b5cf6;
            --accent-cyan: #00f0ff;
            --accent-glow: rgba(0, 240, 255, 0.35);
            --glass-bg: rgba(11, 17, 34, 0.65);
            --glass-border: rgba(255, 255, 255, 0.08);
            --glass-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
            --card-sheen: linear-gradient(135deg, rgba(255, 255, 255, 0.06), transparent 70%);
            --grid-color: rgba(59, 130, 246, 0.06);
            --font-display: 'Syne', sans-serif;
            --font-heading: 'Plus Jakarta Sans', sans-serif;
            --font-main: 'Inter', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }

        /* 2. LIGHT (Clean Pristine Architectural) */
        :root[data-theme="light"] {
            --bg-primary: #f8fafc;
            --bg-secondary: #f1f5f9;
            --bg-tertiary: #e2e8f0;
            --text-primary: #090d16;
            --text-secondary: #475569;
            --text-muted: #64748b;
            --accent-primary: #2563eb;
            --accent-secondary: #7c3aed;
            --accent-cyan: #0284c7;
            --accent-glow: rgba(37, 99, 235, 0.25);
            --glass-bg: rgba(255, 255, 255, 0.85);
            --glass-border: rgba(0, 0, 0, 0.08);
            --glass-shadow: 0 20px 40px rgba(15, 23, 42, 0.06);
            --card-sheen: linear-gradient(135deg, rgba(255, 255, 255, 0.8), transparent 70%);
            --grid-color: rgba(37, 99, 235, 0.04);
            --font-display: 'Syne', sans-serif;
            --font-heading: 'Plus Jakarta Sans', sans-serif;
            --font-main: 'Inter', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }

        /* 3. AURORA (Deep Mystical Violet / Emerald) */
        :root[data-theme="aurora"] {
            --bg-primary: #090314;
            --bg-secondary: #140827;
            --bg-tertiary: #200d3d;
            --text-primary: #faf5ff;
            --text-secondary: #c084fc;
            --text-muted: #9333ea;
            --accent-primary: #a855f7;
            --accent-secondary: #ec4899;
            --accent-cyan: #2dd4bf;
            --accent-glow: rgba(168, 85, 247, 0.4);
            --glass-bg: rgba(20, 8, 39, 0.65);
            --glass-border: rgba(255, 255, 255, 0.09);
            --glass-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
            --card-sheen: linear-gradient(135deg, rgba(255, 255, 255, 0.07), transparent 70%);
            --grid-color: rgba(168, 85, 247, 0.06);
            --font-display: 'Syne', sans-serif;
            --font-heading: 'Plus Jakarta Sans', sans-serif;
            --font-main: 'Inter', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }

        /* 4. OCEAN (Bioluminescent Abyssal Teal / Azure) */
        :root[data-theme="ocean"] {
            --bg-primary: #020f18;
            --bg-secondary: #061e2e;
            --bg-tertiary: #0c2d44;
            --text-primary: #f0fdfa;
            --text-secondary: #38bdf8;
            --text-muted: #0284c7;
            --accent-primary: #0284c7;
            --accent-secondary: #06b6d4;
            --accent-cyan: #14b8a6;
            --accent-glow: rgba(2, 132, 199, 0.4);
            --glass-bg: rgba(6, 30, 46, 0.65);
            --glass-border: rgba(255, 255, 255, 0.08);
            --glass-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
            --card-sheen: linear-gradient(135deg, rgba(255, 255, 255, 0.06), transparent 70%);
            --grid-color: rgba(6, 182, 212, 0.05);
            --font-display: 'Syne', sans-serif;
            --font-heading: 'Plus Jakarta Sans', sans-serif;
            --font-main: 'Inter', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }

        /* 5. SUNSET (Cinematic Warm Dusk Amber / Crimson) */
        :root[data-theme="sunset"] {
            --bg-primary: #150604;
            --bg-secondary: #260c08;
            --bg-tertiary: #3a150e;
            --text-primary: #fff7ed;
            --text-secondary: #fb923c;
            --text-muted: #ea580c;
            --accent-primary: #ea580c;
            --accent-secondary: #e11d48;
            --accent-cyan: #facc15;
            --accent-glow: rgba(234, 88, 12, 0.4);
            --glass-bg: rgba(38, 12, 8, 0.65);
            --glass-border: rgba(255, 255, 255, 0.08);
            --glass-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
            --card-sheen: linear-gradient(135deg, rgba(255, 255, 255, 0.06), transparent 70%);
            --grid-color: rgba(234, 88, 12, 0.05);
            --font-display: 'Syne', sans-serif;
            --font-heading: 'Plus Jakarta Sans', sans-serif;
            --font-main: 'Inter', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }

        /* ==========================================================================
           2. RESET & BASE FOUNDATIONS
           ========================================================================== */
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: var(--font-main);
        }

        html {
            scroll-behavior: auto;
            -webkit-text-size-adjust: 100%;
            overflow-x: clip;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-primary);
            font-family: var(--font-main);
            transition: background-color 800ms cubic-bezier(0.22, 1, 0.36, 1), color 800ms ease;
            overflow-x: hidden;
            position: relative;
            min-height: 100vh;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        a, button, input, textarea, .premium-project-card, .cert-card, .milestone-card, .hamburger {
            cursor: pointer;
        }

        .font-mono {
            font-family: var(--font-mono) !important;
        }

        .font-display {
            font-family: var(--font-display) !important;
        }

        .font-heading {
            font-family: var(--font-heading) !important;
        }

        /* Global Typography Hierarchy */
        h1, h2, h3, h4, h5, h6 {
            color: var(--text-primary);
            letter-spacing: -0.025em;
            line-height: 1.15;
            transition: color 800ms ease;
            font-family: var(--font-heading);
        }

        p {
            color: var(--text-secondary);
            line-height: 1.8;
            transition: color 800ms ease;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .highlight {
            background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-cyan) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: inline-block;
            transition: all 800ms ease;
        }

        .container {
            max-width: 1240px;
            margin: 0 auto;
            padding: 0 2rem;
            position: relative;
            z-index: 10;
        }

        .section-padding {
            padding: 160px 0;
            position: relative;
        }

        .section-meta {
            font-size: 0.85rem;
            color: var(--accent-cyan);
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 1.25rem;
            display: inline-flex;
            align-items: center;
            gap: 1.25rem;
            font-family: var(--font-mono);
            font-weight: 600;
            transition: color 800ms ease;
        }

        .section-meta::after {
            content: '';
            height: 1px;
            width: 80px;
            background: linear-gradient(90deg, var(--accent-cyan), transparent);
            transition: background 800ms ease;
        }

        .section-title {
            font-family: var(--font-display);
            font-size: clamp(2.5rem, 5vw, 4rem);
            font-weight: 800;
            letter-spacing: -0.03em;
            margin-bottom: 4rem;
            text-align: left;
            position: relative;
        }

        /* ==========================================================================
           3. BACKGROUND ATMOSPHERES & 3D SPATIAL GRID
           ========================================================================== */
        #theme-atmospheres {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -3;
            pointer-events: none;
            overflow: hidden;
            contain: paint;
        }

        .theme-layer {
            position: absolute;
            inset: 0;
            opacity: 0;
            transition: opacity 1.2s cubic-bezier(0.22, 1, 0.36, 1);
        }

        [data-theme="midnight"] .layer-midnight { opacity: 1; }
        [data-theme="ocean"] .layer-ocean { opacity: 1; }
        [data-theme="aurora"] .layer-aurora { opacity: 1; }
        [data-theme="sunset"] .layer-sunset { opacity: 1; }
        [data-theme="light"] .layer-light { opacity: 1; }

        /* Midnight Atmosphere */
        .layer-midnight .mid-glow {
            position: absolute;
            top: -20%;
            left: -20%;
            width: 140%;
            height: 140%;
            background: radial-gradient(circle at 60% 40%, rgba(59, 130, 246, 0.12) 0%, rgba(0, 240, 255, 0.04) 40%, transparent 70%);
            animation: atm-drift 24s infinite alternate ease-in-out;
        }

        /* Ocean Atmosphere */
        .layer-ocean .ocean-rays {
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: repeating-linear-gradient(45deg, transparent, rgba(20, 184, 166, 0.03) 4%, transparent 8%);
            animation: ray-drift 32s infinite linear;
        }
        .layer-ocean .ocean-glow {
            position: absolute;
            bottom: -20%;
            left: 0;
            width: 100%;
            height: 70%;
            background: radial-gradient(ellipse at bottom, rgba(2, 132, 199, 0.18) 0%, rgba(20, 184, 166, 0.06) 50%, transparent 75%);
            animation: atm-drift 16s infinite alternate ease-in-out;
        }

        /* Aurora Atmosphere */
        .layer-aurora .aurora-ribbon-1, .layer-aurora .aurora-ribbon-2 {
            position: absolute;
            width: 150%;
            height: 45%;
            border-radius: 50%;
            filter: blur(100px);
        }
        .layer-aurora .aurora-ribbon-1 {
            top: 5%;
            left: -25%;
            background: radial-gradient(ellipse, rgba(168, 85, 247, 0.22) 0%, transparent 70%);
            animation: aurora-wave 20s infinite alternate ease-in-out;
        }
        .layer-aurora .aurora-ribbon-2 {
            top: 45%;
            right: -25%;
            background: radial-gradient(ellipse, rgba(45, 212, 191, 0.15) 0%, transparent 70%);
            animation: aurora-wave 26s infinite alternate-reverse ease-in-out;
        }

        /* Sunset Atmosphere */
        .layer-sunset .sunset-sun {
            position: absolute;
            bottom: -10%;
            left: 50%;
            transform: translateX(-50%);
            width: 85vw;
            height: 85vw;
            max-width: 900px;
            max-height: 900px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(234, 88, 12, 0.2) 0%, rgba(225, 29, 72, 0.08) 45%, transparent 70%);
            filter: blur(80px);
            animation: pulse-glow 12s infinite alternate ease-in-out;
        }
        .layer-sunset .sunset-clouds {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(180deg, rgba(21, 6, 4, 0.95) 0%, transparent 100%);
        }

        /* Light Atmosphere */
        .layer-light .light-mesh-1, .layer-light .light-mesh-2 {
            position: absolute;
            width: 70vw;
            height: 70vw;
            border-radius: 50%;
            filter: blur(120px);
        }
        .layer-light .light-mesh-1 {
            top: -15%;
            left: -15%;
            background: radial-gradient(circle, rgba(37, 99, 235, 0.08) 0%, transparent 70%);
            animation: mesh-float 26s infinite alternate ease-in-out;
        }
        .layer-light .light-mesh-2 {
            bottom: -15%;
            right: -15%;
            background: radial-gradient(circle, rgba(2, 132, 199, 0.06) 0%, transparent 70%);
            animation: mesh-float 22s infinite alternate-reverse ease-in-out;
        }

        @keyframes atm-drift { 100% { transform: translate(4%, 4%); } }
        @keyframes ray-drift { 100% { transform: translate(-10%, -10%); } }
        @keyframes aurora-wave { 100% { transform: translateY(12%) rotate(4deg); } }
        @keyframes pulse-glow { 100% { transform: translateX(-50%) scale(1.08); opacity: 0.9; } }
        @keyframes mesh-float { 100% { transform: translate(8%, 8%); } }

        /* 3D Spatial Grid Background */
        .spatial-grid-wrap {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -2;
            pointer-events: none;
            overflow: hidden;
            contain: paint;
            perspective: 800px;
        }

        .spatial-grid-plane {
            position: absolute;
            top: -20%;
            left: -50%;
            width: 200%;
            height: 160%;
            background-image: 
                linear-gradient(to right, var(--grid-color) 1px, transparent 1px),
                linear-gradient(to bottom, var(--grid-color) 1px, transparent 1px);
            background-size: 70px 70px;
            transform: rotateX(68deg) translateY(-25%);
            transform-origin: 50% 100%;
            opacity: 0.8;
            mask-image: radial-gradient(ellipse at 50% 40%, black 20%, transparent 80%);
            -webkit-mask-image: radial-gradient(ellipse at 50% 40%, black 20%, transparent 80%);
            transition: background-size 800ms ease;
        }

        /* Ambient Cursor Spotlight */
        #cursor-spotlight {
            position: fixed;
            top: 0;
            left: 0;
            width: 520px;
            height: 520px;
            border-radius: 50%;
            background: radial-gradient(circle at center, var(--accent-glow) 0%, transparent 70%);
            pointer-events: none;
            transform: translate(-50%, -50%);
            z-index: -1;
            opacity: 0.45;
            transition: opacity 0.5s ease;
            mix-blend-mode: screen;
        }

        [data-theme="light"] #cursor-spotlight {
            mix-blend-mode: multiply;
            opacity: 0.2;
        }

        /* Canvas Particles */
        #particles-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            pointer-events: none;
            contain: strict;
        }

        @media (hover: none), (prefers-reduced-motion: reduce) {
            #cursor-spotlight {
                display: none;
            }
        }

        @media (max-width: 768px) {
            #cursor-spotlight {
                width: 360px;
                height: 360px;
            }
        }

        /* Scroll Progress Bar */
        .scroll-progress {
            position: fixed;
            top: 0;
            left: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--accent-primary), var(--accent-cyan));
            width: 0%;
            z-index: 10000;
            transition: width 0.1s ease;
            box-shadow: 0 0 10px var(--accent-cyan);
        }

        /* ==========================================================================
           4. CINEMATIC ENTRANCE OVERLAY
           ========================================================================== */
        #cinematic-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: #03060d;
            z-index: 99999;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.9s;
        }

        #cinematic-overlay.loaded {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .intro-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            opacity: 0;
            animation: introFadeIn 0.5s ease forwards 0.2s, introFadeOut 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards 1.9s;
        }

        .intro-line {
            width: 0px;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--accent-cyan), var(--accent-primary), transparent);
            margin-bottom: 1.75rem;
            animation: introLineExpand 1.3s cubic-bezier(0.22, 1, 0.36, 1) forwards 0.3s;
            box-shadow: 0 0 15px var(--accent-cyan);
        }

        .intro-name {
            font-family: var(--font-display);
            font-size: clamp(1.8rem, 4vw, 2.6rem);
            font-weight: 800;
            letter-spacing: 5px;
            color: #ffffff;
            margin-bottom: 0.75rem;
            text-align: center;
            clip-path: polygon(0 100%, 100% 100%, 100% 100%, 0 100%);
            animation: introTextReveal 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards 0.6s;
        }

        .intro-role {
            font-size: 0.9rem;
            color: var(--accent-cyan);
            letter-spacing: 4px;
            text-transform: uppercase;
            opacity: 0;
            transform: translateY(12px);
            animation: introRoleFade 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards 1s;
        }

        @keyframes introFadeIn { to { opacity: 1; } }
        @keyframes introFadeOut { to { opacity: 0; transform: scale(1.04); filter: blur(6px); } }
        @keyframes introLineExpand { to { width: min(340px, 80vw); } }
        @keyframes introTextReveal { to { clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); } }
        @keyframes introRoleFade { to { opacity: 1; transform: translateY(0); } }

        /* Staggered Entrance Animations */
        .cine-blur-up {
            opacity: 0;
            filter: blur(14px);
            transform: translateY(35px);
        }

        .cine-blur-up.start-anim {
            animation: cineBlurUpAnim 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        .cine-scale {
            opacity: 0;
            filter: blur(12px);
            transform: scale(0.94);
        }

        .cine-scale.start-anim {
            animation: cineScaleAnim 1.4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        .cine-nav {
            opacity: 0;
            transform: translateX(-50%) translateY(-35px) scale(0.97);
        }

        .cine-nav.start-anim {
            animation: cineNavDrop 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        @keyframes cineBlurUpAnim { to { opacity: 1; filter: blur(0); transform: translateY(0); } }
        @keyframes cineScaleAnim { to { opacity: 1; filter: blur(0); transform: scale(1); } }
        @keyframes cineNavDrop { to { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); } }

        /* ==========================================================================
           5. REUSABLE GLASS & BUTTON DESIGN TOKENS
           ========================================================================== */
        .glass {
            background: var(--glass-bg);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            box-shadow: var(--glass-shadow);
            position: relative;
            overflow: hidden;
            transition: background 800ms ease, border-color 800ms ease, box-shadow 800ms ease, transform 0.4s ease;
        }

        .glass::before {
            content: '';
            position: absolute;
            inset: 0;
            background: var(--card-sheen);
            pointer-events: none;
            z-index: 1;
        }

        /* Tactile CTA Buttons */
        .cta-btn {
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
            color: #ffffff;
            padding: 0.9rem 2.2rem;
            border-radius: 999px;
            font-weight: 600;
            font-size: 0.95rem;
            letter-spacing: 0.5px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 0.85rem;
            position: relative;
            overflow: hidden;
            z-index: 1;
            box-shadow: 0 10px 25px rgba(59, 130, 246, 0.35);
            transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .cta-btn::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 60%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transform: skewX(-25deg);
            transition: 0.6s;
            z-index: -1;
        }

        .cta-btn:hover::after {
            left: 150%;
        }

        .cta-btn:hover {
            box-shadow: 0 14px 35px rgba(0, 240, 255, 0.45);
            transform: translateY(-3px) scale(1.02);
            color: #ffffff;
        }

        .btn-outline {
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            color: var(--text-primary);
            padding: 0.9rem 2.2rem;
            border-radius: 999px;
            font-weight: 600;
            font-size: 0.95rem;
            letter-spacing: 0.5px;
            display: inline-flex;
            align-items: center;
            gap: 0.85rem;
            transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1), background-color 800ms ease, border-color 800ms ease;
        }

        .btn-outline:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 240, 255, 0.2);
        }

        [data-theme="light"] .btn-outline:hover {
            background: rgba(0, 0, 0, 0.05);
            border-color: var(--accent-primary);
            color: var(--accent-primary);
        }

        /* ==========================================================================
           6. FLOATING TRANSLUCENT NAVIGATION DOCK
           ========================================================================== */
        nav#navbar {
            position: fixed;
            top: 1.5rem;
            left: 50%;
            transform: translateX(-50%);
            width: fit-content;
            max-width: calc(100vw - 32px);
            z-index: 1000;
            background: var(--glass-bg);
            backdrop-filter: blur(28px);
            -webkit-backdrop-filter: blur(28px);
            border: 1px solid var(--glass-border);
            border-radius: 999px;
            padding: 0.4rem 0.6rem;
            box-shadow: var(--glass-shadow);
            transition: all 800ms cubic-bezier(0.22, 1, 0.36, 1);
            opacity: 0;
            animation: cineNavDrop 1s cubic-bezier(0.22, 1, 0.36, 1) 2.4s forwards;
        }

        nav#navbar.scrolled {
            top: 1rem;
            padding: 0.35rem 0.5rem;
            background: var(--bg-primary);
            opacity: 0.96;
            box-shadow: 0 18px 45px rgba(0, 0, 0, 0.65);
            transform: translateX(-50%) scale(0.98);
            border-color: rgba(255, 255, 255, 0.08);
        }

        [data-theme="light"] nav#navbar.scrolled {
            box-shadow: 0 18px 45px rgba(0, 0, 0, 0.08);
            border-color: rgba(0, 0, 0, 0.08);
        }

        .nav-container {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .nav-links {
            display: flex;
            align-items: center;
            position: relative;
            gap: 0.25rem;
        }

        .nav-link-item {
            color: var(--text-secondary);
            font-size: 0.85rem;
            font-weight: 500;
            padding: 0.6rem 1rem;
            border-radius: 999px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: color 0.3s ease;
            position: relative;
            z-index: 2;
            white-space: nowrap;
        }

        .nav-link-item i {
            font-size: 0.85rem;
        }

        .nav-link-item:hover {
            color: var(--text-primary);
        }

        .nav-link-item.active {
            color: var(--text-primary);
        }

        .nav-indicator {
            position: absolute;
            top: 0;
            height: 100%;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(0, 240, 255, 0.15));
            border: 1px solid var(--accent-cyan);
            border-radius: 999px;
            z-index: 1;
            transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
            opacity: 0;
            pointer-events: none;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.25);
        }

        [data-theme="light"] .nav-indicator {
            background: rgba(37, 99, 235, 0.12);
            border-color: var(--accent-primary);
        }

        /* Nav Actions: Theme Switcher & Hamburger */
        .nav-actions {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            padding-left: 0.3rem;
            border-left: 1px solid var(--glass-border);
        }

        .theme-toggle-btn {
            background: transparent;
            border: 1px solid var(--glass-border);
            color: var(--text-secondary);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            transition: all 0.3s ease;
        }

        .theme-toggle-btn:hover {
            color: var(--accent-cyan);
            border-color: var(--accent-cyan);
            transform: rotate(30deg);
            box-shadow: 0 0 12px var(--accent-glow);
        }

        .hamburger {
            display: none;
            background: transparent;
            border: none;
            color: var(--text-primary);
            font-size: 1.25rem;
            padding: 0.5rem;
        }

        /* Desktop Chapter Side Indicator */
        .chapter-indicator {
            position: fixed;
            right: 2.5rem;
            top: 50%;
            transform: translateY(-50%);
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
            z-index: 999;
        }

        .chapter-dot {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.75rem;
            color: var(--text-muted);
            letter-spacing: 1px;
            transition: all 0.4s ease;
        }

        .chapter-dot .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--text-muted);
            transition: all 0.4s ease;
        }

        .chapter-dot:hover, .chapter-dot.active {
            color: var(--accent-cyan);
            transform: translateX(-4px);
        }

        .chapter-dot:hover .dot, .chapter-dot.active .dot {
            background: var(--accent-cyan);
            box-shadow: 0 0 12px var(--accent-cyan);
            transform: scale(1.4);
        }

        /* ==========================================================================
           7. HERO SECTION (EDITORIAL & 3D VISUAL CENTERPIECE)
           ========================================================================== */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            position: relative;
            padding-top: 150px;
            padding-bottom: 80px;
            overflow: visible;
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: 4rem;
            align-items: center;
            width: 100%;
        }

        .hero-content {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            position: relative;
            z-index: 5;
        }

        .hero-name-container {
            margin-bottom: 1.5rem;
            display: flex;
            flex-direction: column;
            line-height: 0.98;
            font-family: var(--font-display);
        }

        .hero-name-container h1,
        .hero-name-row {
            font-family: var(--font-display);
            font-size: clamp(3.2rem, 7.5vw, 6.2rem);
            font-weight: 800;
            letter-spacing: -0.04em;
            margin: 0;
            display: block;
            color: var(--text-primary);
            text-transform: uppercase;
        }

        .hero-role-badge {
            font-family: var(--font-mono);
            font-size: 1.1rem;
            font-weight: 500;
            letter-spacing: 2px;
            color: var(--accent-cyan);
            margin-bottom: 1.5rem;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            text-transform: uppercase;
        }

        .hero-role-badge .role-beacon {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--accent-cyan);
            box-shadow: 0 0 10px var(--accent-cyan);
            animation: pulse-beacon 2s infinite ease-in-out;
        }

        @keyframes pulse-beacon {
            0%, 100% { opacity: 0.4; transform: scale(0.9); }
            50% { opacity: 1; transform: scale(1.3); }
        }

        /* Profile Controls */
        .profile-controls {
            display: flex;
            flex-wrap: wrap;
            gap: 0.6rem;
            margin: 0 0 2rem;
            align-items: center;
        }

        .profile-controls-label {
            width: 100%;
            color: var(--text-muted);
            font-size: 0.72rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-family: var(--font-mono);
            font-weight: 600;
            margin-bottom: 0.25rem;
        }

        .profile-control {
            border: 1px solid var(--glass-border);
            border-radius: 999px;
            background: var(--glass-bg);
            color: var(--text-secondary);
            padding: 0.55rem 1.1rem;
            font: 600 0.8rem var(--font-mono);
            letter-spacing: 0.5px;
            transition: all 0.4s ease;
        }

        .profile-control:hover {
            color: var(--text-primary);
            border-color: var(--accent-cyan);
            transform: translateY(-2px);
        }

        .profile-control[aria-pressed="true"] {
            color: var(--text-primary);
            border-color: var(--profile-accent, var(--accent-cyan));
            background: color-mix(in srgb, var(--profile-accent, var(--accent-cyan)) 18%, transparent);
            box-shadow: 0 0 18px color-mix(in srgb, var(--profile-accent, var(--accent-cyan)) 25%, transparent);
            transform: translateY(-2px);
        }

        #hero-desc {
            font-size: 1.15rem;
            line-height: 1.8;
            margin-bottom: 2.5rem;
            max-width: 540px;
            color: var(--text-secondary);
        }

        .hero-btns {
            display: flex;
            gap: 1.25rem;
            flex-wrap: wrap;
            margin-bottom: 2rem;
        }

        /* Social Links */
        .social-links {
            display: flex;
            gap: 1.25rem;
        }

        .social-links a {
            font-size: 1.3rem;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            backdrop-filter: blur(12px);
            transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .social-links a:hover {
            color: var(--accent-cyan);
            transform: translateY(-5px) scale(1.08);
            border-color: var(--accent-cyan);
            box-shadow: 0 8px 25px var(--accent-glow);
        }

        /* Hero 3D Centerpiece Visual */
        .hero-visual {
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            perspective: 1400px;
        }

        .editorial-profile-wrapper {
            position: relative;
            width: 440px;
            height: 530px;
            display: flex;
            justify-content: center;
            align-items: center;
            transform-style: preserve-3d;
            will-change: transform;
            --profile-accent: var(--accent-cyan);
            --profile-accent-alt: var(--accent-secondary);
            transition: --profile-accent 0.7s, --profile-accent-alt 0.7s;
        }

        /* Deep Visual Layers */
        .profile-glow-bg {
            position: absolute;
            width: 120%;
            height: 120%;
            background: radial-gradient(circle at 50% 50%, var(--profile-accent) 0%, var(--profile-accent-alt) 40%, transparent 70%);
            filter: blur(55px);
            z-index: 0;
            opacity: 0.35;
            transform: translateZ(-40px);
            animation: pulse-profile-glow 6s alternate infinite ease-in-out;
            pointer-events: none;
            transition: background 0.7s ease;
        }

        .deco-line {
            position: absolute;
            border-radius: 36px;
            border: 1.5px solid var(--profile-accent);
            opacity: 0.4;
            pointer-events: none;
            z-index: 1;
            transition: border-color 0.7s, border-radius 0.7s, transform 0.7s;
        }

        .deco-line-1 {
            width: 420px;
            height: 500px;
            transform: translateZ(-15px) rotate(-4deg);
        }

        .deco-line-2 {
            width: 400px;
            height: 480px;
            border-color: var(--profile-accent-alt);
            transform: translateZ(10px) rotate(3deg);
        }

        .editorial-img-container {
            position: relative;
            width: 370px;
            height: 460px;
            border-radius: 28px;
            overflow: hidden;
            background-color: var(--bg-secondary);
            z-index: 2;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.55);
            border: 1px solid rgba(255, 255, 255, 0.12);
            transform: translateZ(30px);
            transition: all 0.7s cubic-bezier(0.22, 1, 0.36, 1);
        }

        [data-theme="light"] .editorial-img-container {
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.12);
            border-color: rgba(0, 0, 0, 0.08);
        }

        .editorial-img-container::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 28px;
            padding: 2px;
            background: linear-gradient(135deg, var(--profile-accent), var(--profile-accent-alt), transparent 70%);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
            z-index: 4;
        }

        /* Subtle Light Sweep */
        .editorial-img-container::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(60deg, transparent 40%, rgba(255, 255, 255, 0.12) 50%, transparent 60%);
            transform: rotate(25deg);
            pointer-events: none;
            z-index: 3;
            animation: light-sweep 9s infinite ease-in-out;
        }

        @keyframes light-sweep {
            0% { transform: translateY(-80%) rotate(25deg); }
            50%, 100% { transform: translateY(80%) rotate(25deg); }
        }

        .editorial-img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center top;
            border-radius: 50%;
            clip-path: circle(49% at 50% 50%);
            transform: scale(1);
            filter: blur(0);
            transition: all 0.7s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .editorial-profile-wrapper.is-morphing .editorial-img-container img {
            transform: scale(1.04);
            filter: blur(3px);
        }

        /* Profile-Specific Geometry Morphing */
        .editorial-profile-wrapper[data-profile="react"] .editorial-img-container img {
            border-radius: 50%;
            clip-path: circle(49% at 50% 50%);
        }

        .editorial-profile-wrapper[data-profile="node"] .editorial-img-container img {
            border-radius: 24px;
            clip-path: polygon(8% 0, 92% 0, 100% 10%, 100% 90%, 92% 100%, 8% 100%, 0 90%, 0 10%);
        }

        .editorial-profile-wrapper[data-profile="javascript"] .editorial-img-container img {
            border-radius: 12px 52px 12px 52px;
            clip-path: polygon(0 7%, 86% 0, 100% 12%, 93% 100%, 10% 93%, 0 78%);
        }

        .editorial-profile-wrapper[data-profile="fullstack"] .editorial-img-container img {
            border-radius: 42% 58% 55% 45% / 38% 42% 58% 62%;
            clip-path: polygon(18% 2%, 78% 0, 98% 18%, 94% 78%, 76% 98%, 20% 94%, 2% 76%, 6% 20%);
        }

        .editorial-profile-wrapper[data-profile="react"] .editorial-img-container {
            clip-path: inset(0 round 28px);
        }

        .editorial-profile-wrapper[data-profile="node"] .editorial-img-container {
            border-radius: 24px;
            clip-path: polygon(8% 0, 92% 0, 100% 10%, 100% 90%, 92% 100%, 8% 100%, 0 90%, 0 10%);
        }

        .editorial-profile-wrapper[data-profile="javascript"] .editorial-img-container {
            border-radius: 12px 52px 12px 52px;
            clip-path: polygon(0 7%, 86% 0, 100% 12%, 93% 100%, 10% 93%, 0 78%);
        }

        .editorial-profile-wrapper[data-profile="fullstack"] .editorial-img-container {
            border-radius: 42px;
            clip-path: circle(49% at 50% 50%);
        }

        /* Status Identity Pill */
        .editorial-status {
            position: absolute;
            bottom: 12px;
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            padding: 0.65rem 1.4rem;
            border-radius: 999px;
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 2px;
            color: var(--text-primary);
            z-index: 5;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
            transform: translateZ(55px);
            transition: all 0.7s ease;
        }

        .editorial-status .status-dot {
            width: 7px;
            height: 7px;
            background: var(--profile-accent);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--profile-accent);
            animation: pulse-blob 2s infinite alternate;
            transition: background 0.7s, box-shadow 0.7s;
        }

        /* 3D Orbiting Badges */
        .editorial-badge {
            position: absolute;
            width: 52px;
            height: 52px;
            border-radius: 16px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.6rem;
            z-index: 6;
            transform: translateZ(65px);
            box-shadow: var(--glass-shadow);
            background: var(--glass-bg);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid var(--glass-border);
            color: var(--text-secondary);
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .editorial-badge:hover {
            transform: translateZ(85px) scale(1.15);
            box-shadow: 0 15px 30px var(--accent-glow);
            border-color: var(--accent-cyan);
            color: var(--text-primary);
        }

        .editorial-badge[aria-pressed="true"] {
            color: var(--profile-accent);
            border-color: var(--profile-accent);
            box-shadow: 0 0 22px color-mix(in srgb, var(--profile-accent) 35%, transparent);
            transform: translateZ(75px) scale(1.08);
        }

        .badge-react {
            top: 12%;
            left: -28px;
            animation: orbit-1 9s ease-in-out infinite alternate;
        }

        .badge-js {
            bottom: 16%;
            right: -28px;
            animation: orbit-2 10s ease-in-out infinite alternate-reverse;
        }

        .badge-node {
            top: -24px;
            right: 12%;
            animation: orbit-3 11s ease-in-out infinite alternate;
        }

        .badge-fullstack {
            bottom: 4%;
            left: 8%;
            animation: orbit-1 11s ease-in-out infinite alternate-reverse;
        }

        .editorial-badge::after {
            content: attr(data-tooltip);
            position: absolute;
            top: -40px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--bg-secondary);
            color: var(--text-primary);
            font-size: 0.75rem;
            padding: 5px 12px;
            border-radius: 8px;
            border: 1px solid var(--glass-border);
            opacity: 0;
            pointer-events: none;
            transition: 0.3s;
            white-space: nowrap;
            font-family: var(--font-mono);
            font-weight: 600;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
        }

        .editorial-badge:hover::after {
            opacity: 1;
            top: -50px;
        }

        @keyframes orbit-1 { 0% { transform: translateZ(65px) translate(0, 0); } 100% { transform: translateZ(65px) translate(10px, -12px); } }
        @keyframes orbit-2 { 0% { transform: translateZ(65px) translate(0, 0); } 100% { transform: translateZ(65px) translate(-10px, 12px); } }
        @keyframes orbit-3 { 0% { transform: translateZ(65px) translate(0, 0); } 100% { transform: translateZ(65px) translate(8px, 10px); } }
        @keyframes pulse-profile-glow { 0% { opacity: 0.25; transform: translateZ(-40px) scale(0.95); } 100% { opacity: 0.45; transform: translateZ(-40px) scale(1.08); } }
        @keyframes pulse-blob { 0% { opacity: 0.5; } 100% { opacity: 1; } }

        /* ==========================================================================
           8. ABOUT SECTION (ORIGIN STORYTELLING)
           ========================================================================== */
        .origin-grid {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 5rem;
            align-items: center;
        }

        .story-text p {
            font-size: 1.15rem;
            line-height: 1.9;
            margin-bottom: 2rem;
            color: var(--text-secondary);
        }

        /* Digital Builder Holographic ID Card */
        .id-card {
            margin-top: 3.5rem;
            padding: 2.5rem;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.08) 0%, rgba(0, 240, 255, 0.03) 100%);
            border: 1px solid var(--glass-border);
            border-left: 3px solid var(--accent-cyan);
            border-radius: 0 20px 20px 0;
            backdrop-filter: blur(16px);
            position: relative;
            overflow: hidden;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.35);
            transition: all 0.5s ease;
        }

        .id-card:hover {
            transform: translateY(-4px);
            border-left-color: var(--accent-primary);
            box-shadow: 0 20px 50px rgba(0, 240, 255, 0.15);
        }

        .id-meta {
            font-size: 0.78rem;
            color: var(--accent-cyan);
            margin-bottom: 1.25rem;
            letter-spacing: 2px;
            font-family: var(--font-mono);
            font-weight: 600;
        }

        .id-card h4 {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            letter-spacing: -0.01em;
        }

        /* Visual Timeline Nodes */
        .story-nodes-wrap {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .story-nodes {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.25rem;
            position: relative;
            padding: 3rem 2.5rem;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            backdrop-filter: blur(20px);
            box-shadow: var(--glass-shadow);
        }

        .story-node {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.75rem;
            color: var(--text-secondary);
            font-size: 0.85rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-family: var(--font-mono);
            font-weight: 600;
            transition: all 0.4s ease;
        }

        .story-node .dot {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            border: 2px solid var(--accent-cyan);
            background: var(--bg-primary);
            z-index: 2;
            transition: all 0.4s ease;
            box-shadow: 0 0 10px rgba(0, 240, 255, 0.3);
        }

        .story-node:hover, .story-node:has(.highlight) {
            color: var(--text-primary);
        }

        .story-node:hover .dot, .story-node:has(.highlight) .dot {
            background: var(--accent-cyan);
            box-shadow: 0 0 20px var(--accent-cyan);
            transform: scale(1.2);
        }

        .story-line {
            width: 2px;
            height: 50px;
            background: linear-gradient(180deg, var(--accent-cyan), var(--accent-primary));
            opacity: 0.6;
        }

        /* ==========================================================================
           9. SKILLS SECTION (ARSENAL TECHNICAL SHOWCASE)
           ========================================================================== */
        .arsenal-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
            gap: 2.25rem;
            position: relative;
        }

        .arsenal-category {
            padding: 3rem 2.25rem;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-top: 2px solid var(--accent-primary);
            border-radius: 20px;
            backdrop-filter: blur(20px);
            box-shadow: var(--glass-shadow);
            transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
            position: relative;
            overflow: hidden;
        }

        .arsenal-category:hover {
            transform: translateY(-8px);
            border-top-color: var(--accent-cyan);
            box-shadow: 0 20px 45px rgba(0, 240, 255, 0.15);
        }

        .arsenal-header {
            font-size: 0.9rem;
            color: var(--accent-cyan);
            letter-spacing: 2px;
            margin-bottom: 2.25rem;
            text-transform: uppercase;
            font-family: var(--font-mono);
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .arsenal-items {
            display: flex;
            flex-direction: column;
            gap: 1.15rem;
        }

        .arsenal-item {
            font-size: 1.05rem;
            font-weight: 500;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 1rem;
            transition: all 0.3s ease;
        }

        .arsenal-item::before {
            content: '';
            width: 14px;
            height: 2px;
            background: var(--glass-border);
            transition: all 0.3s ease;
        }

        .arsenal-category:hover .arsenal-item::before {
            background: var(--accent-cyan);
            width: 22px;
        }

        .arsenal-item:hover {
            color: var(--accent-cyan);
            transform: translateX(6px);
        }

        /* ==========================================================================
           10. PROJECTS SECTION (CASE STUDIES & FILTERING)
           ========================================================================== */
        .project-filters {
            display: flex;
            gap: 1.5rem;
            margin-bottom: 3.5rem;
            border-bottom: 1px solid var(--glass-border);
            padding-bottom: 1.25rem;
            overflow-x: auto;
            scrollbar-width: none;
        }

        .project-filters::-webkit-scrollbar { display: none; }

        .filter-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-size: 0.9rem;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            font-family: var(--font-mono);
            padding-bottom: 0.75rem;
            position: relative;
            transition: all 0.3s ease;
        }

        .filter-btn::after {
            content: '';
            position: absolute;
            bottom: -1.25rem;
            left: 0;
            width: 0%;
            height: 2px;
            background: var(--accent-cyan);
            box-shadow: 0 0 10px var(--accent-cyan);
            transition: width 0.3s ease;
        }

        .filter-btn:hover, .filter-btn.active {
            color: var(--text-primary);
        }

        .filter-btn.active::after {
            width: 100%;
        }

        .projects-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 3rem;
            align-items: start;
        }

        /* Premium Project Card */
        .premium-project-card {
            display: flex;
            flex-direction: column;
            background: var(--glass-bg);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            overflow: hidden;
            box-shadow: var(--glass-shadow);
            position: relative;
            transition: all 0.6s cubic-bezier(0.22, 1, 0.36, 1);
            perspective: 1000px;
        }

        .premium-project-card:hover {
            transform: translateY(-8px);
            border-color: rgba(0, 240, 255, 0.3);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
        }

        [data-theme="light"] .premium-project-card:hover {
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.1);
        }

        /* Featured Asymmetrical Layout */
        .premium-project-card.featured {
            grid-column: 1 / -1;
            flex-direction: row;
            min-height: 480px;
        }

        .premium-project-card.featured .project-visual {
            width: 56%;
            border-right: 1px solid var(--glass-border);
            border-bottom: none;
            padding: 2.25rem;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(4, 7, 16, 0.7);
        }

        .premium-project-card.featured .project-info {
            width: 44%;
            padding: 4rem 3.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        /* Supporting Cards Layout */
        .premium-project-card.supporting:nth-child(3n) {
            margin-top: 2rem;
        }

        .premium-project-card.supporting .project-visual {
            width: 100%;
            height: 270px;
            border-bottom: 1px solid var(--glass-border);
            padding: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(4, 7, 16, 0.7);
        }

        .premium-project-card.supporting .project-info {
            padding: 2.5rem;
            flex-grow: 1;
        }

        .project-visual {
            position: relative;
            overflow: hidden;
        }

        .project-visual img {
            width: 100%;
            height: 100%;
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s;
        }

        .visual-overlay {
            position: absolute;
            inset: 0;
            background: rgba(4, 7, 16, 0.5);
            backdrop-filter: blur(4px);
            opacity: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: opacity 0.4s ease;
            pointer-events: none;
        }

        .view-project-cta {
            opacity: 0;
            transform: translateY(16px);
            transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
            padding: 0.85rem 1.8rem;
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-cyan));
            color: #ffffff;
            border-radius: 999px;
            font-weight: 600;
            font-size: 0.85rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            box-shadow: 0 10px 25px rgba(59, 130, 246, 0.5);
        }

        .premium-project-card:hover .project-visual img {
            transform: scale(1.04);
        }

        .premium-project-card:hover .visual-overlay {
            opacity: 1;
        }

        .premium-project-card:hover .view-project-cta {
            opacity: 1;
            transform: translateY(0);
        }

        [data-theme="light"] .project-visual {
            background: rgba(226, 232, 240, 0.6);
        }

        [data-theme="light"] .project-visual img {
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            border-color: rgba(0, 0, 0, 0.08);
        }

        /* Project Metadata */
        .project-number {
            font-family: var(--font-mono);
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--accent-cyan);
            margin-bottom: 0.75rem;
            letter-spacing: 2px;
        }

        .project-title {
            font-family: var(--font-heading);
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 1rem;
            letter-spacing: -0.02em;
        }

        .project-desc {
            font-size: 1rem;
            line-height: 1.7;
            margin-bottom: 1.75rem;
            color: var(--text-secondary);
        }

        .tech-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 0.6rem;
            margin-bottom: 2rem;
        }

        .tech-pill {
            font-size: 0.75rem;
            font-weight: 600;
            font-family: var(--font-mono);
            padding: 0.35rem 0.85rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
            color: var(--text-secondary);
            transition: all 0.3s ease;
        }

        .premium-project-card:hover .tech-pill {
            border-color: rgba(0, 240, 255, 0.25);
            color: var(--text-primary);
        }

        .project-actions {
            display: flex;
            gap: 1.5rem;
            margin-top: auto;
        }

        .project-link {
            font-family: var(--font-mono);
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 1px;
            color: var(--accent-cyan);
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            transition: all 0.3s ease;
        }

        .project-link:hover {
            color: var(--accent-primary);
            transform: translateX(4px);
        }

        /* ==========================================================================
           11. JOURNEY & FOUNDATION (TIMELINES)
           ========================================================================== */
        .journey-line {
            position: relative;
            max-width: 860px;
            padding-left: 2.5rem;
            border-left: 2px solid var(--glass-border);
            margin-left: 1.5rem;
            transition: border-color 800ms ease;
        }

        .journey-item {
            position: relative;
            margin-bottom: 4.5rem;
            padding-left: 2rem;
            transition: all 0.4s ease;
        }

        .journey-item:last-child {
            margin-bottom: 0;
        }

        .journey-dot {
            position: absolute;
            left: -2.95rem;
            top: 0.2rem;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: var(--bg-primary);
            border: 2px solid var(--accent-cyan);
            box-shadow: 0 0 10px rgba(0, 240, 255, 0.3);
            transition: all 0.4s ease;
        }

        .journey-item:hover .journey-dot {
            background: var(--accent-cyan);
            box-shadow: 0 0 18px var(--accent-cyan);
            transform: scale(1.3);
        }

        .journey-date {
            font-size: 0.85rem;
            color: var(--accent-cyan);
            margin-bottom: 0.5rem;
            display: block;
            font-weight: 600;
            letter-spacing: 1px;
        }

        .journey-title {
            font-size: 1.4rem;
            font-weight: 700;
            margin-bottom: 0.35rem;
            letter-spacing: -0.01em;
        }

        .journey-org {
            font-size: 0.95rem;
            color: var(--text-secondary);
            margin-bottom: 1.15rem;
            font-family: var(--font-mono);
        }

        /* ==========================================================================
           12. ACHIEVEMENTS (MILESTONES)
           ========================================================================== */
        .milestones-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2.5rem;
        }

        .milestone-card {
            padding: 3rem 2.5rem;
            display: flex;
            flex-direction: column;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-top: 2px solid var(--accent-primary);
            border-radius: 20px;
            backdrop-filter: blur(20px);
            box-shadow: var(--glass-shadow);
            transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
            position: relative;
        }

        .milestone-card:hover {
            border-top-color: var(--accent-cyan);
            transform: translateY(-8px);
            box-shadow: 0 20px 45px rgba(0, 240, 255, 0.15);
        }

        .milestone-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }

        .milestone-num {
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--accent-cyan);
            letter-spacing: 2px;
        }

        .milestone-icon {
            font-size: 1.6rem;
            color: var(--accent-cyan);
            opacity: 0.75;
            transition: all 0.4s ease;
        }

        .milestone-card:hover .milestone-icon {
            opacity: 1;
            transform: scale(1.15) rotate(12deg);
            text-shadow: 0 0 15px var(--accent-cyan);
        }

        .milestone-title {
            font-size: 1.35rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            line-height: 1.35;
        }

        .milestone-org {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-bottom: 1.5rem;
            font-family: var(--font-mono);
        }

        .milestone-desc {
            font-size: 0.98rem;
            flex-grow: 1;
            margin-bottom: 2rem;
            color: var(--text-secondary);
            line-height: 1.7;
        }

        .view-proof-btn {
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--accent-cyan);
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            background: none;
            border: none;
            padding: 0;
            transition: all 0.3s ease;
            margin-top: auto;
        }

        .view-proof-btn i {
            transition: transform 0.3s ease;
        }

        .milestone-card:hover .view-proof-btn {
            color: var(--accent-primary);
        }

        .milestone-card:hover .view-proof-btn i {
            transform: translateX(6px);
        }

        /* ==========================================================================
           13. CERTIFICATIONS (3D CYLINDER SHOWCASE & VIEW TOGGLE)
           ========================================================================== */
        .cert-controls-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .cert-view-toggle {
            display: inline-flex;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 999px;
            padding: 0.3rem;
            gap: 0.25rem;
        }

        .cert-toggle-btn {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            padding: 0.5rem 1.2rem;
            border-radius: 999px;
            font-family: var(--font-mono);
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 1px;
            transition: all 0.3s ease;
        }

        .cert-toggle-btn.active {
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-cyan));
            color: #ffffff;
            box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
        }

        .cert-showcase {
            --card-width: min(32vw, 360px);
            --card-height: calc(var(--card-width) * 0.68);
            position: relative;
            min-height: 640px;
            display: grid;
            place-items: center;
            overflow: hidden;
            isolation: isolate;
        }

        .cert-showcase::before {
            content: '';
            position: absolute;
            width: min(75vw, 750px);
            height: min(20vw, 200px);
            bottom: 3rem;
            border-radius: 50%;
            background: var(--accent-primary);
            opacity: 0.14;
            filter: blur(80px);
            pointer-events: none;
        }

        .cert-stage {
            width: 100%;
            height: 610px;
            display: grid;
            place-items: center;
            perspective: 1400px;
            perspective-origin: 50% 48%;
            touch-action: pan-y;
        }

        .cert-ring {
            position: relative;
            width: var(--card-width);
            height: var(--card-height);
            transform-style: preserve-3d;
            transform: rotateX(-12deg);
            transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
            will-change: transform;
        }

        .cert-ring.is-dragging {
            transition: none;
            cursor: grabbing;
        }

        /* 3D Ring Card Styling */
        .cert-ring .cert-card {
            position: absolute;
            inset: 0;
            width: var(--card-width);
            height: var(--card-height);
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
            transform: rotateY(var(--card-angle)) translateZ(var(--ring-radius));
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 18px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
            transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.4s ease, box-shadow 0.4s ease;
        }

        .cert-ring .cert-card:hover {
            transform: rotateY(var(--card-angle)) translateZ(calc(var(--ring-radius) + 25px)) scale(1.08);
            border-color: var(--accent-cyan);
            box-shadow: 0 20px 45px rgba(0, 240, 255, 0.3);
            z-index: 10;
        }

        .cert-img-container {
            width: 100%;
            height: 58%;
            background-color: var(--bg-secondary);
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            position: relative;
            border-bottom: 1px solid var(--glass-border);
        }

        .cert-img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .cert-card:hover .cert-img-container img {
            transform: scale(1.08);
        }

        .cert-overlay {
            position: absolute;
            inset: 0;
            background: rgba(6, 9, 17, 0.65);
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0;
            transition: opacity 0.3s ease;
            backdrop-filter: blur(3px);
        }

        .cert-card:hover .cert-overlay {
            opacity: 1;
        }

        .cert-overlay i {
            font-size: 2rem;
            color: #ffffff;
            transform: translateY(12px);
            transition: transform 0.3s ease;
        }

        .cert-card:hover .cert-overlay i {
            transform: translateY(0);
        }

        .cert-info {
            padding: 1rem 1.25rem;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
        }

        .cert-title {
            font-size: 0.95rem;
            font-weight: 700;
            line-height: 1.35;
            color: var(--text-primary);
        }

        .cert-org {
            font-size: 0.78rem;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .cert-date {
            font-size: 0.75rem;
            color: var(--accent-cyan);
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .view-cert-btn {
            margin-top: auto;
            padding-top: 0.6rem;
            border-top: 1px solid var(--glass-border);
            background: none;
            border: none;
            color: var(--accent-cyan);
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            transition: all 0.3s ease;
        }

        .cert-card:hover .view-cert-btn {
            color: var(--accent-primary);
        }

        .cert-card:hover .view-cert-btn i {
            transform: translateX(4px);
        }

        /* Static Grid Mode (Optional View Toggle or Mobile/Reduced Motion) */
        .cert-showcase.is-grid-view {
            min-height: auto;
            overflow: visible;
        }

        .cert-showcase.is-grid-view .cert-stage {
            height: auto;
            perspective: none;
        }

        .cert-showcase.is-grid-view .cert-ring {
            width: 100%;
            height: auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
            transform: none !important;
        }

        .cert-showcase.is-grid-view .cert-ring .cert-card {
            position: relative;
            inset: auto;
            width: auto;
            height: 320px;
            transform: none !important;
        }

        .cert-showcase.is-grid-view .cert-ring .cert-card:hover {
            transform: translateY(-8px) !important;
        }

        .cert-showcase-hint {
            position: absolute;
            bottom: 0.75rem;
            left: 50%;
            transform: translateX(-50%);
            color: var(--text-muted);
            font: 0.75rem var(--font-mono);
            letter-spacing: 1.5px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        /* ==========================================================================
           14. PROFESSIONAL SNAPSHOT (RESUME)
           ========================================================================== */
        .snapshot-panel {
            padding: 5.5rem 3.5rem;
            background: var(--glass-bg);
            backdrop-filter: blur(28px);
            border: 1px solid var(--glass-border);
            border-radius: 28px;
            text-align: center;
            position: relative;
            overflow: hidden;
            box-shadow: var(--glass-shadow);
        }

        .snapshot-panel::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, var(--accent-primary), var(--accent-cyan));
            box-shadow: 0 0 15px var(--accent-cyan);
        }

        .snapshot-panel h3 {
            font-size: 1.25rem;
            color: var(--accent-cyan);
            margin-bottom: 0.75rem;
            font-family: var(--font-mono);
            letter-spacing: 2px;
        }

        .snapshot-panel h2 {
            font-family: var(--font-display);
            font-size: clamp(2.4rem, 5vw, 3.8rem);
            font-weight: 800;
            margin-bottom: 2rem;
            letter-spacing: -0.03em;
        }

        /* ==========================================================================
           15. NEXT CHAPTER (CONTACT & FOOTER)
           ========================================================================== */
        .ending-scene {
            text-align: center;
            max-width: 820px;
            margin: 0 auto;
            padding: 3rem 0;
        }

        .ending-scene h2 {
            font-family: var(--font-display);
            font-size: clamp(2.8rem, 6vw, 4.8rem);
            font-weight: 800;
            letter-spacing: -0.04em;
            margin-bottom: 1.5rem;
            line-height: 1.05;
        }

        .contact-form {
            padding: 3.5rem;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            backdrop-filter: blur(24px);
            text-align: left;
            box-shadow: var(--glass-shadow);
            position: relative;
        }

        .input-group {
            margin-bottom: 2rem;
        }

        .input-group input,
        .input-group textarea {
            width: 100%;
            padding: 1.1rem 0;
            background: transparent;
            border: none;
            border-bottom: 1px solid var(--glass-border);
            color: var(--text-primary);
            outline: none;
            font-size: 1.05rem;
            transition: all 0.4s ease;
            border-radius: 0;
        }

        .input-group input:focus,
        .input-group textarea:focus {
            border-bottom-color: var(--accent-cyan);
            box-shadow: 0 1px 0 var(--accent-cyan);
        }

        .input-group textarea {
            resize: vertical;
            min-height: 120px;
        }

        .success-message {
            position: absolute;
            inset: 0;
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            border-radius: 24px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            opacity: 0;
            visibility: hidden;
            transition: all 0.4s ease;
            z-index: 10;
        }

        .success-message.active {
            opacity: 1;
            visibility: visible;
        }

        .success-message i {
            font-size: 4rem;
            color: #10b981;
            margin-bottom: 1rem;
            transform: scale(0);
            transition: transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .success-message.active i {
            transform: scale(1);
        }

        /* Footer */
        footer {
            padding: 5rem 0 3rem 0;
            text-align: center;
            margin-top: 5rem;
            border-top: 1px solid var(--glass-border);
        }

        .footer-social {
            display: flex;
            justify-content: center;
            gap: 2rem;
            margin: 2rem 0;
        }

        .footer-social a {
            color: var(--text-secondary);
            font-size: 1.6rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            transition: all 0.4s ease;
        }

        .footer-social a:hover {
            color: var(--accent-cyan);
            border-color: var(--accent-cyan);
            transform: translateY(-4px) scale(1.1);
            box-shadow: 0 8px 25px var(--accent-glow);
        }

        .copyright {
            font-size: 0.88rem;
            color: var(--text-muted);
            letter-spacing: 1px;
            font-family: var(--font-mono);
        }

        /* ==========================================================================
           16. MODAL & LIGHTBOX
           ========================================================================== */
        .modal {
            display: flex;
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            background: rgba(4, 7, 15, 0.95);
            backdrop-filter: blur(16px);
            z-index: 20000;
            justify-content: center;
            align-items: center;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.5s;
        }

        .modal.active {
            opacity: 1;
            visibility: visible;
        }

        .modal-content {
            position: relative;
            width: 90%;
            max-width: 1050px;
            height: 85vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 1.5rem;
            transform: scale(0.95);
            transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .modal.active .modal-content {
            transform: scale(1);
        }

        .close-modal {
            position: absolute;
            top: -45px;
            right: 0;
            background: none;
            border: none;
            color: var(--text-secondary);
            font-size: 2.2rem;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: all 0.3s;
        }

        .close-modal:hover {
            color: #ffffff;
            transform: rotate(90deg);
        }

        #modal-media-container {
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        #modal-media-container img,
        #modal-media-container iframe {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            border-radius: 12px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
        }

        /* Back to top button */
        #back-to-top {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 52px;
            height: 52px;
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            color: var(--text-primary);
            border-radius: 50%;
            font-size: 1.25rem;
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0;
            visibility: hidden;
            transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
            z-index: 999;
            box-shadow: var(--glass-shadow);
        }

        #back-to-top.visible {
            opacity: 1;
            visibility: visible;
        }

        #back-to-top:hover {
            background: var(--accent-primary);
            border-color: var(--accent-primary);
            color: #ffffff;
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(59, 130, 246, 0.4);
        }

        /* ==========================================================================
           17. SCROLL-TRIGGERED REVEAL ANIMATIONS
           ========================================================================== */
        .reveal-fade {
            opacity: 0;
            transition: opacity 1s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .reveal-fade.active {
            opacity: 1;
        }

        .reveal-up {
            opacity: 0;
            transform: translateY(40px);
            transition: all 1s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .reveal-up.active {
            opacity: 1;
            transform: translateY(0);
        }

        .reveal-blur {
            opacity: 0;
            filter: blur(12px);
            transform: translateY(25px);
            transition: all 1.2s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .reveal-blur.active {
            opacity: 1;
            filter: blur(0);
            transform: translateY(0);
        }

        .reveal-scale {
            opacity: 0;
            transform: scale(0.94);
            filter: blur(8px);
            transition: all 1.1s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .reveal-scale.active {
            opacity: 1;
            transform: scale(1);
