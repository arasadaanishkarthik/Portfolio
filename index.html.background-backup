            const cards = Array.from(certRingEl.querySelectorAll('.cert-card'));
            const angleStep = 360 / cards.length;
            const cardWidth = parseFloat(getComputedStyle(certRingEl).width) || 340;
            const radius = Math.max(340, Math.round(cardWidth / (2 * Math.tan(Math.PI / cards.length))));
            certRingEl.style.setProperty('--ring-radius', radius + 'px');

            cards.forEach((card, index) => {
                card.style.setProperty('--card-angle', (index * angleStep) + 'deg');
            });

            const reducedMotion = prefersReducedMotion;
            let rotation = 0;
            let animationFrame;
            let lastTime = performance.now();
            let isPaused = false;
            let isDragging = false;
            let startX = 0;
            let startRotation = 0;

            const renderRing = () => {
                certRingEl.style.transform = 'rotateX(-12deg) rotateY(' + rotation + 'deg)';
            };

            const animateRing = (time) => {
                const elapsed = time - lastTime;
                lastTime = time;
                if (!isPaused && !isDragging && !certsContainerEl.classList.contains('is-grid-view')) {
                    rotation = (rotation + elapsed * 0.014) % 360;
                    renderRing();
                }
                if (pageIsVisible) animationFrame = requestAnimationFrame(animateRing);
            };

            if (!reducedMotion.matches && !isLowPowerDevice) {
                animationFrame = requestAnimationFrame(animateRing);
                window.addEventListener('portfolio:visibility-resume', () => {
                    if (!animationFrame) animationFrame = requestAnimationFrame(animateRing);
                });
            }

            // Pointer Drag Handlers
            const pause = () => { isPaused = true; };
            const resume = () => { if (!isDragging) isPaused = false; };
            certStage.addEventListener('pointerenter', pause);
            certStage.addEventListener('pointerleave', resume);

            certStage.addEventListener('pointerdown', (e) => {
                if (certsContainerEl.classList.contains('is-grid-view')) return;
                isDragging = true;
                isPaused = true;
                startX = e.clientX;
                startRotation = rotation;
                certRingEl.classList.add('is-dragging');
                certStage.setPointerCapture(e.pointerId);
            });

            certStage.addEventListener('pointermove', (e) => {
                if (!isDragging) return;
                rotation = startRotation + (e.clientX - startX) * 0.45;
                renderRing();
            });

            const endDrag = (e) => {
                if (!isDragging) return;
                isDragging = false;
                isPaused = false;
                certRingEl.classList.remove('is-dragging');
                if (e.pointerId) certStage.releasePointerCapture(e.pointerId);
            };

            certStage.addEventListener('pointerup', endDrag);
            certStage.addEventListener('pointercancel', endDrag);

            // View Switcher: 3D Ring vs Grid View
            if (btnViewRing && btnViewGrid) {
                btnViewRing.addEventListener('click', () => {
                    btnViewRing.classList.add('active');
                    btnViewGrid.classList.remove('active');
                    certsContainerEl.classList.remove('is-grid-view');
                    renderRing();
                });

                btnViewGrid.addEventListener('click', () => {
                    btnViewGrid.classList.add('active');
                    btnViewRing.classList.remove('active');
                    certsContainerEl.classList.add('is-grid-view');
