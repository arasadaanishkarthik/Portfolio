        // =========================================
        // 3. 3D CYLINDER CERTIFICATIONS SHOWCASE
        // =========================================
        const certsContainerEl = document.getElementById('certs-container');
        const certStage = document.getElementById('cert-stage');
        const certRingEl = document.getElementById('cert-ring');
        const btnViewRing = document.getElementById('btn-view-ring');
        const btnViewGrid = document.getElementById('btn-view-grid');

        if (certsContainerEl && certStage && certRingEl) {
            certificationsData.forEach((cert, index) => {
                const div = document.createElement('div');
                div.className = 'cert-card glass';
                div.setAttribute('role', 'button');
                div.setAttribute('tabindex', '0');
                div.setAttribute('aria-label', 'View ' + cert.title + ' certificate');

                div.innerHTML = 
                    '<div class="cert-img-container">' +
                        '<img src="' + cert.file + '" alt="' + cert.title + '" onerror="this.src=\'assets/images/certificates/Mern Stack.png\'; this.onerror=null;">' +
                        '<div class="cert-overlay">' +
                            '<i class="fas fa-search-plus"></i>' +
                        '</div>' +
                    '</div>' +
                    '<div class="cert-info">' +
                        '<div class="cert-title">' + cert.title + '</div>' +
                        '<div class="cert-org font-mono"><i class="fas fa-building" style="color:var(--accent-primary)"></i> ' + cert.org + '</div>' +
                        '<div class="cert-date font-mono"><i class="fas fa-calendar-check" style="color:var(--accent-primary)"></i> ' + cert.date + '</div>' +
