        }
        if (!isTouchDevice && !prefersReducedMotion.matches) {
            cursorFrame = requestAnimationFrame(updateCursorSpotlight);
            window.addEventListener('portfolio:visibility-resume', () => {
                if (!cursorFrame) cursorFrame = requestAnimationFrame(updateCursorSpotlight);
            });
        }

        /* =========================================
           6. AUTONOMOUS CANVAS PARTICLES PHYSICS
           ========================================= */
        const canvas = document.getElementById('particles-canvas');
        if (canvas) {
            const ctx = canvas.getContext('2d');
            let particlesArray = [];
            let particleFrame = 0;
            let canvasWidth = 0;
            let canvasHeight = 0;
            let canvasScale = 1;
            const particleColors = {
                midnight: 'rgba(0, 240, 255, 0.45)',
                ocean: 'rgba(20, 184, 166, 0.45)',
                aurora: 'rgba(192, 132, 252, 0.45)',
                sunset: 'rgba(251, 146, 60, 0.55)',
                light: 'rgba(37, 99, 235, 0.25)'
            };

            function initCanvas() {
                canvasWidth = window.innerWidth;
                canvasHeight = window.innerHeight;
                canvasScale = Math.min(window.devicePixelRatio || 1, isLowPowerDevice ? 1 : 1.5);
                canvas.width = Math.floor(canvasWidth * canvasScale);
                canvas.height = Math.floor(canvasHeight * canvasScale);
                canvas.style.width = canvasWidth + 'px';
                canvas.style.height = canvasHeight + 'px';
                ctx.setTransform(canvasScale, 0, 0, canvasScale, 0, 0);
                particlesArray = [];
                let numberOfParticles = Math.min(90, Math.round((canvasWidth * canvasHeight) / 24000));
                if (isLowPowerDevice) numberOfParticles = Math.min(numberOfParticles, 25);

                for (let i = 0; i < numberOfParticles; i++) {
                    let x = Math.random() * canvasWidth;
                    let y = Math.random() * canvasHeight;
                    let size = Math.random() * 1.8 + 0.6;
                    let speedX = (Math.random() * 0.5) - 0.25;
                    let speedY = (Math.random() * 0.5) - 0.25;
                    particlesArray.push({ x, y, size, speedX, speedY });
                }
            }

            function animateParticles() {
                if (!pageIsVisible) {
                    particleFrame = 0;
                    return;
                }
                ctx.clearRect(0, 0, canvasWidth, canvasHeight);
                const theme = document.documentElement.getAttribute('data-theme') || 'midnight';
                const connectionsEnabled = theme === 'midnight' || theme === 'ocean' || theme === 'aurora';
                const particleColor = particleColors[theme] || particleColors.midnight;

                for (let i = 0; i < particlesArray.length; i++) {
                    let p = particlesArray[i];

                    // Theme-specific Physics
                    if (theme === 'ocean') {
                        p.y -= Math.abs(p.speedY) * 0.8;
                        p.x += Math.sin(p.y * 0.01) * 0.5;
                        if (p.y < -10) p.y = canvasHeight + 10;
                    } else if (theme === 'sunset') {
                        p.y -= Math.abs(p.speedY) * 0.6;
                        if (p.y < -10) p.y = canvasHeight + 10;
                    } else {
                        p.x += p.speedX;
                        p.y += p.speedY;
                        if (p.x < 0 || p.x > canvasWidth) p.speedX *= -1;
                        if (p.y < 0 || p.y > canvasHeight) p.speedY *= -1;
                    }

                    // Mouse Proximity Deflection
                    let dx = mouseX - p.x;
                    let dy = mouseY - p.y;
                    let distanceSquared = dx * dx + dy * dy;
                    if (distanceSquared > 0 && distanceSquared < 14400) {
                        let dist = Math.sqrt(distanceSquared);
                        p.x -= (dx / dist) * 1.5;
                        p.y -= (dy / dist) * 1.5;
                    }

                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);

                    // Theme-tailored Particle Colors
                    ctx.fillStyle = particleColor;

                    ctx.fill();

                    // Subtle constellation connection threads
                    if (connectionsEnabled) {
                        for (let j = i + 1; j < particlesArray.length; j++) {
                            let p2 = particlesArray[j];
                            let cdx = p.x - p2.x;
                            let cdy = p.y - p2.y;
                            let connectionDistanceSquared = cdx * cdx + cdy * cdy;
                            if (connectionDistanceSquared < 9025) {
                                let cdist = Math.sqrt(connectionDistanceSquared);
                                ctx.beginPath();
                                ctx.strokeStyle = theme === 'midnight'
                                    ? 'rgba(0, 240, 255, ' + (0.12 - cdist / 950) + ')'
                                    : (theme === 'ocean' ? 'rgba(20, 184, 166, ' + (0.10 - cdist / 950) + ')' : 'rgba(168, 85, 247, ' + (0.10 - cdist / 950) + ')');
                                ctx.lineWidth = 0.5;
                                ctx.moveTo(p.x, p.y);
                                ctx.lineTo(p2.x, p2.y);
                                ctx.stroke();
                            }
                        }
                    }
                }
                particleFrame = requestAnimationFrame(animateParticles);
            }

            if (!prefersReducedMotion.matches) {
                initCanvas();
                particleFrame = requestAnimationFrame(animateParticles);
                window.addEventListener('portfolio:visibility-resume', () => {
                    if (!particleFrame) particleFrame = requestAnimationFrame(animateParticles);
                });
                let resizeFrame = 0;
                window.addEventListener('resize', () => {
                    if (!resizeFrame) {
                        resizeFrame = requestAnimationFrame(() => {
                            resizeFrame = 0;
                            initCanvas();
                        });
                    }
                }, { passive: true });
            }
        }

        /* =========================================
           7. THEME SWITCHER & SCROLL SPY SYSTEM
           ========================================= */
        const themeList = ['midnight', 'ocean', 'aurora', 'sunset', 'light'];
        const sectionThemes = {
            'home': 'midnight',
            'about': 'ocean',
            'skills': 'aurora',
            'projects': 'midnight',
            'training': 'sunset',
            'achievements': 'ocean',
            'certifications': 'aurora',
            'education': 'sunset',
            'resume': 'light',
            'contact': 'midnight'
        };

        const themeToggleBtn = document.getElementById('theme-toggle-btn');
        let userOverrodeTheme = false;

        function applyTheme(themeName) {
            document.documentElement.setAttribute('data-theme', themeName);
        }

        if (themeToggleBtn) {
            themeToggleBtn.addEventListener('click', () => {
                userOverrodeTheme = true;
                const current = document.documentElement.getAttribute('data-theme') || 'midnight';
                const nextIndex = (themeList.indexOf(current) + 1) % themeList.length;
                applyTheme(themeList[nextIndex]);
            });
